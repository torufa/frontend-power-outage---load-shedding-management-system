# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# --- LIVE BACKEND & DATABASE CONNECTION ---
# Point this to your live backend (e.g. deployed on Render, Railway, Vercel, or local http://localhost:5000/api/v1)
NEXT_PUBLIC_API_URL="https://your-backend-api.onrender.com/api/v1"
VITE_API_URL="https://your-backend-api.onrender.com/api/v1"

# --- STRIPE PAYMENT INTEGRATION ---
# Your Stripe Publishable Key (from Stripe Dashboard > Developers > API keys)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_51xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
VITE_STRIPE_PUBLISHABLE_KEY="pk_test_51xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

